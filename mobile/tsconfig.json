{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./sources/*"
      ]
    }
  },
  "include": [
    "index.ts",
    "app.config.js",
    "sources/app/**/*.ts",
    "sources/app/**/*.tsx",
    "sources/**/*.d.ts",
    "sources/tmux-mobile/**/*.ts",
    "sources/tmux-mobile/**/*.tsx",
    "sources/theme.ts"
  ]
}
